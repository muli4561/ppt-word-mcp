# ---- LLM 配置（OpenAI 兼容接口）----
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=qwen3.7-plus
LLM_TEMPERATURE=0.7

# ---- 可选：视觉模型（PPT Master 图片生成）----
# VISION_ENABLED=0
# VISION_BACKEND=openai
# VISION_BASE_URL=
# VISION_API_KEY=
# VISION_MODEL=
# VISION_IMAGE_SIZE=1K

# ---- 服务安全 ----
# Bearer Token 鉴权，留空则无需鉴权
PPT_WORD_GEN_TOKEN=
# 签名下载链接的密钥，留空则自动生成
# DOWNLOAD_SIGNING_SECRET=

# ---- 路径 ----
# 本机直跑留空；docker compose 部署时显式设为 /ppt
URL_PREFIX=
# 旧 ppt-service 部署保留数据时可设为 ppt-service_ppt-service-data
DATA_VOLUME_NAME=ppt-word-gen-data

# ---- 并发 & 任务 ----
MAX_CONCURRENT_TASKS=2
MAX_AGENT_STEPS=80

# ---- Mock 演示模式 ----
# MOCK_LLM=1 无需 API Key 即可全流程演示；接入真实模型时改为 0 并填 LLM_API_KEY
MOCK_LLM=1
